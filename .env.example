# Database configuration
# Connect to MySQL using:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/yatraai
# Note: If MySQL is not reachable or unconfigured, the app provides automatic fallback to sqlite:///./yatraai.db for local dev

# Groq API for personalized AI recommendations and deep destination insights
GROQ_API_KEY="your_groq_api_key_here"

# Geoapify API key for geocoding and reverse geocoding place discovery
GEOAPIFY_API_KEY="your_geoapify_api_key_here"

# JWT Secret Key for token generation
SECRET_KEY=yatraai_super_secret_jwt_key_college_project_change_in_production_2026

# YOLO Model Configuration
YOLO_MODEL_PATH=./models/yatraai_landmarks.pt

# Application Settings
ENVIRONMENT=development
API_PREFIX=/api
BACKEND_PORT=8000
FRONTEND_PORT=3000

